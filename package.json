{
  "name": "@bfra.me/renovate-action",
  "version": "10.30.0",
  "private": true,
  "description": "GitHub Action for Self-Hosted Renovate",
  "keywords": [
    "renovate",
    "self-hosted",
    "action",
    "github-action",
    "composite",
    "nodejs",
    "typescript",
    "github-actions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bfra-me/renovate-action.git"
  },
  "license": "MIT",
  "author": "Marcus R. Brown <git@mrbro.dev>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "bootstrap": "pnpm install --prefer-offline --loglevel warn",
    "build": "tsup && pnpm -r --stream run build",
    "build-action": "tsup",
    "check": "pnpm run check-types && pnpm run lint && pnpm run check-docs",
    "check-docs": "pnpm --filter docs run check",
    "check-types": "tsc --noEmit",
    "dev": "tsup --watch",
    "fix": "eslint --fix",
    "postinstall": "simple-git-hooks",
    "lint": "eslint",
    "test": "vitest run"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,jsx,tsx,css,md,json,yaml,yml}": [
      "pnpm run fix"
    ]
  },
  "prettier": "@bfra.me/prettier-config/120-proof",
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@bfra.me/eslint-config": "0.52.1",
    "@bfra.me/prettier-config": "0.16.11",
    "@bfra.me/tsconfig": "0.13.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "24.13.3",
    "@vitest/eslint-plugin": "1.6.27",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "esbuild-plugin-license": "1.2.3",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-node-dependencies": "2.2.0",
    "eslint-plugin-prettier": "5.5.6",
    "jiti": "2.7.0",
    "js-yaml": "4.3.2",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "semantic-release-export-data": "1.2.0",
    "simple-git-hooks": "2.14.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.20.0"
  }
}
